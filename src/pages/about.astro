---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Tag from '../components/Tag.astro';

const skills = [
  "Python & C/C++", "Deep Learning", "Computer Vision", "AWS (4x Certified)", 
  "Power BI", "JavaScript/React", "Node.js", "Docker"
];
---

<Layout title="About | HL.">
  <div class="container section">
    <div class="header-section">
      <h1>About</h1>
    </div>

    <div class="about-grid">
      <!-- Main Content -->
      <div class="about-content">
        <div class="prose">
          <p class="lead">I'm a researcher and software engineer focused on machine learning, image generation, and intelligent systems.</p>
          
          <h2>Background</h2>
          <p>With a strong foundation in building deep learning frameworks from scratch and data modeling, I specialize in developing scalable products powered by state-of-the-art AI. From writing custom C++ autograd engines to training YOLOv8 models for computer vision, my approach emphasizes both technical depth and practical deployment.</p>
          
          <p>Currently, I'm working as a Research Assistant focusing on image generation technologies. I explore novel generative architectures and optimize inference pipelines. I also hold 4 AWS Certifications, equipping me with the skills to architect and deploy highly available cloud systems.</p>

          <h2>Approach</h2>
          <p>I believe that the best ML systems are not just highly accurate, but resilient and efficient. I favor understanding algorithms from first principles, designing strict data schemas, and deploying models with accessible interfaces that hide backend complexity while giving users control.</p>

          <div class="skills-section mt-8">
            <h3>Core Capabilities</h3>
            <div class="skills-tags">
              {skills.map(skill => (
                <Tag name={skill} />
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="about-sidebar">
        <div class="profile-card card">
          <div class="profile-image">
            <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=400&auto=format&fit=crop" alt="Profile Picture" />
          </div>
          <div class="profile-info text-center mt-4">
            <h3 class="font-mono text-lg mb-1">H.L.</h3>
            <p class="text-muted text-sm mb-4">ML Engineer & Researcher</p>
            <div class="profile-links">
              <Button href="/resume" variant="outline" class="w-full mb-2">View Resume</Button>
              <Button href="/contact" variant="primary" class="w-full">Get in Touch</Button>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style>
  .section {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .header-section {
    margin-bottom: 3rem;
  }

  .about-grid {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  @media (min-width: 1024px) {
    .about-grid {
      flex-direction: row;
    }
  }

  .about-content {
    flex: 1;
    max-width: 65ch;
  }

  .about-sidebar {
    width: 100%;
    max-width: 320px;
  }

  .prose {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--primary-text);
  }

  .prose .lead {
    font-size: 1.5rem;
    line-height: 1.5;
    color: var(--primary-text);
    margin-bottom: 2rem;
    font-weight: 500;
  }

  .prose h2 {
    font-size: 1.875rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose h3 {
    font-size: 1.5rem;
    margin-top: 1.5rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1.25rem;
    color: var(--secondary-text);
  }

  .mt-8 { margin-top: 2rem; }
  .mt-4 { margin-top: 1rem; }
  .mb-1 { margin-bottom: 0.25rem; }
  .mb-4 { margin-bottom: 1rem; }
  .mb-2 { margin-bottom: 0.5rem; }
  .text-center { text-align: center; }
  .w-full { width: 100%; justify-content: center; }

  .skills-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .profile-image {
    width: 120px;
    height: 120px;
    margin: 0 auto;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--border);
  }

  .profile-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
</style>
