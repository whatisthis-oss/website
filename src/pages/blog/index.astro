---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Card from '../../components/Card.astro';
import Tag from '../../components/Tag.astro';

const posts = await getCollection('blog');
posts.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
---

<Layout title="Blog | HL.">
  <div class="container section">
    <div class="header-section">
      <h1>Blog</h1>
      <p class="text-secondary">Thoughts on design, systems, and AI-powered experiences.</p>
    </div>

    <div class="blog-list">
      {posts.map((post) => (
        <Card href={`/blog/${post.id}`} class="blog-card">
          <div class="blog-content">
            <h2 class="blog-title">{post.data.title}</h2>
            <div class="blog-meta text-muted text-sm">
              <time datetime={post.data.date}>{new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
              {post.data.readingTime && <span class="divider">•</span>}
              {post.data.readingTime && <span>{post.data.readingTime}</span>}
            </div>
            <p class="blog-excerpt text-secondary">{post.data.description}</p>
            <div class="blog-tags">
              {post.data.tags.map((tag) => (
                <Tag name={tag} />
              ))}
            </div>
          </div>
          {post.data.image && (
            <div class="blog-image">
              <img src={post.data.image} alt={post.data.title} />
            </div>
          )}
        </Card>
      ))}
    </div>
  </div>
</Layout>

<style>
  .section {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .header-section {
    margin-bottom: 3rem;
  }

  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .blog-card {
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .blog-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .blog-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .blog-title {
    margin: 0;
    font-size: 1.5rem;
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
  }

  .blog-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .blog-image {
    width: 100%;
    max-width: 240px;
    border-radius: 0.5rem;
    overflow: hidden;
  }

  @media (max-width: 767px) {
    .blog-image {
      max-width: 100%;
      order: -1;
    }
  }

  .blog-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 16/9;
  }
</style>
