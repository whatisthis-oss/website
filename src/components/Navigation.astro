---
const links = [
  { name: 'Home', href: '/' },
  { name: 'Works', href: '/works' },
  { name: 'Blog', href: '/blog' },
  { name: 'About', href: '/about' },
  { name: 'Resume', href: '/resume' },
  { name: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="navbar-wrapper">
  <nav class="navbar glass">
    <div class="nav-left">
      <a href="/" class="logo">HL.</a>
      <div class="nav-socials hidden md:flex">
        <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="social-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path>
          </svg>
        </a>
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
        </a>
      </div>
    </div>
    
    <div class="nav-right">
      <ul class="nav-links">
        {links.map(link => (
          <li>
            <a href={link.href} class={`nav-link ${isActive(link.href) ? 'active' : ''}`}>{link.name}</a>
          </li>
        ))}
      </ul>
      <button class="search-trigger" onclick="window.openSearchPalette && window.openSearchPalette()" aria-label="Search">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="search-shortcut">
          <svg class="cmd-icon" xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: middle; margin-right: 1px; margin-top: -2px;">
            <path d="M18 3a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3H6a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3V6a3 3 0 0 0-3-3 3 3 0 0 0-3 3 3 3 0 0 0 3 3h12a3 3 0 0 0 3-3 3 3 0 0 0-3-3z"></path>
          </svg>K
        </span>
      </button>
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle Dark Mode">
        <!-- Sun icon for dark mode (to switch to light) -->
        <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon icon for light mode (to switch to dark) -->
        <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Mobile Menu Button -->
      <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer glass" id="mobile-drawer">
    <div class="drawer-header">
      <a href="/" class="logo">HL.</a>
      <button class="close-drawer-btn" id="close-drawer-btn" aria-label="Close menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <ul class="mobile-nav-links">
      {links.map(link => (
        <li>
          <a href={link.href} class="mobile-nav-link">{link.name}</a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0.5rem;
    z-index: 50;
    width: 100%;
    padding: 0 1rem;
    display: flex;
    justify-content: center;
  }

  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1.5rem;
    border-radius: 9999px; /* rounded-full */
    width: 100%;
    max-width: 64rem;
    transition: all 0.3s ease;
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .logo {
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.05em;
  }

  .nav-socials {
    display: none;
    align-items: center;
    gap: 0.5rem;
    margin-left: 1rem;
    padding-left: 1rem;
    border-left: 1px solid var(--border);
  }

  @media (min-width: 768px) {
    .nav-socials {
      display: flex;
    }
  }

  .social-icon {
    color: var(--secondary-text);
    transition: color 0.2s ease;
    display: flex;
    padding: 0.25rem;
  }

  .social-icon:hover {
    color: var(--primary-text);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-links {
    display: none;
    list-style: none;
    align-items: center;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--secondary-text);
    position: relative;
  }

  .nav-link:hover {
    color: var(--primary-text);
  }

  .nav-link.active {
    color: var(--primary-text);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -0.25rem;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--accent);
    border-radius: 2px;
  }

  .theme-toggle {
    background: transparent;
    border: none;
    color: var(--secondary-text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    border-radius: 50%;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--primary-text);
    background-color: var(--elevated);
  }

  :global([data-theme="light"]) .sun-icon { display: none; }
  :global([data-theme="dark"]) .moon-icon { display: none; }

  .search-trigger {
    background: var(--elevated);
    border: 1px solid var(--border);
    color: var(--secondary-text);
    cursor: pointer;
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    transition: all 0.2s ease;
  }

  @media (min-width: 768px) {
    .search-trigger {
      display: flex;
    }
  }

  .search-trigger:hover {
    color: var(--primary-text);
    border-color: var(--accent);
  }

  .search-shortcut {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
  }

  .mobile-menu-btn {
    background: transparent;
    border: none;
    color: var(--primary-text);
    cursor: pointer;
    display: flex;
  }

  @media (min-width: 768px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  /* Mobile Drawer */
  .mobile-drawer {
    position: fixed;
    top: 0;
    right: -100%;
    width: 100%;
    max-width: 24rem;
    height: 100vh;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 0;
    border-left: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  }

  .mobile-drawer.open {
    right: 0;
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3rem;
  }

  .close-drawer-btn {
    background: transparent;
    border: none;
    color: var(--primary-text);
    cursor: pointer;
  }

  .mobile-nav-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .mobile-nav-link {
    font-size: 1.5rem;
    font-weight: 500;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const themeToggle = document.getElementById('theme-toggle');
    
    const handleToggleClick = () => {
      const element = document.documentElement;
      
      // Add theme-transition class to allow smooth transition during manual toggle
      element.classList.add('theme-transition');
      
      element.classList.toggle("dark");
      
      const isDark = element.getAttribute('data-theme') === 'dark';
      if (isDark) {
          element.setAttribute('data-theme', 'light');
          localStorage.setItem('theme', 'light');
      } else {
          element.setAttribute('data-theme', 'dark');
          localStorage.setItem('theme', 'dark');
      }
      
      // Remove the class after the transition finishes (0.3s)
      setTimeout(() => {
        element.classList.remove('theme-transition');
      }, 300);
    }

    themeToggle?.addEventListener('click', handleToggleClick);

    // Mobile drawer logic
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const closeDrawerBtn = document.getElementById('close-drawer-btn');
    const mobileDrawer = document.getElementById('mobile-drawer');

    mobileMenuBtn?.addEventListener('click', () => {
      mobileDrawer?.classList.add('open');
    });

    closeDrawerBtn?.addEventListener('click', () => {
      mobileDrawer?.classList.remove('open');
    });
  });
</script>
