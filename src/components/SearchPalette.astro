---
---

<div id="search-palette" class="search-overlay hidden">
  <div class="search-modal">
    <div class="search-header">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" id="search-input" placeholder="Search posts, tags..." autocomplete="off" />
      <button id="close-search" class="close-btn" aria-label="Close Search">
        <span class="close-kbd">ESC</span>
      </button>
    </div>
    <div class="search-results-container">
      <ul id="search-results" class="search-results"></ul>
      <div id="search-empty" class="search-empty hidden">
        No results found.
      </div>
      <div id="search-placeholder" class="search-placeholder">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="placeholder-icon">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span>Type to search posts and tags</span>
        <div class="shortcut-hints">
          <span><kbd>/</kbd> to focus</span>
          <span><kbd>&uarr;&darr;</kbd> navigate</span>
          <span><kbd>&crarr;</kbd> select</span>
          <span><kbd>esc</kbd> close</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background-color: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 12vh;
    padding-left: 1rem;
    padding-right: 1rem;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.15s ease, visibility 0.15s ease;
  }

  .search-overlay.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .search-modal {
    width: 100%;
    max-width: 36rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 0.75rem;
    border: 1px solid var(--border);
    background-color: var(--surface);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.25), 0 0 0 1px color-mix(in srgb, var(--border) 30%, transparent);
    transform: translateY(0) scale(1);
    transition: transform 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .search-overlay.hidden .search-modal {
    transform: translateY(-0.75rem) scale(0.97);
  }

  .search-header {
    display: flex;
    align-items: center;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--border);
    gap: 0.625rem;
  }

  .search-icon {
    color: var(--muted-text);
    flex-shrink: 0;
  }

  #search-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--primary-text);
    font-size: 0.9375rem;
    outline: none;
    font-family: var(--font-sans);
    min-width: 0;
  }

  #search-input::placeholder {
    color: var(--muted-text);
  }

  .close-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .close-kbd {
    background: var(--elevated);
    border: 1px solid var(--border);
    color: var(--muted-text);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    padding: 0.2rem 0.45rem;
    border-radius: 0.25rem;
    letter-spacing: 0.02em;
    line-height: 1;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .close-btn:hover .close-kbd {
    color: var(--primary-text);
    border-color: var(--secondary-text);
  }

  .search-results-container {
    max-height: 50vh;
    overflow-y: auto;
  }

  .search-results {
    list-style: none;
    display: flex;
    flex-direction: column;
    padding: 0.375rem 0;
  }

  .search-results:empty {
    display: none;
  }

  :global(.search-result-item) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.625rem 1rem;
    text-decoration: none;
    color: var(--primary-text);
    border-left: 2px solid transparent;
    transition: background-color 0.1s ease, border-color 0.1s ease;
    cursor: pointer;
  }

  :global(.search-result-item:hover),
  :global(.search-result-item.is-active) {
    background-color: color-mix(in srgb, var(--accent) 8%, transparent);
    border-left-color: var(--accent);
  }

  :global(.search-result-item.is-active) {
    background-color: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  :global(.search-result-title) {
    font-weight: 600;
    font-size: 0.875rem;
  }

  :global(.search-result-item.is-active .search-result-title) {
    color: var(--accent);
  }

  :global(.search-result-desc) {
    font-size: 0.8125rem;
    color: var(--secondary-text);
    line-height: 1.35;
  }

  .search-empty,
  .search-placeholder {
    padding: 2rem 1rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--muted-text);
  }

  .search-empty.hidden,
  .search-placeholder.hidden {
    display: none;
  }

  .placeholder-icon {
    display: block;
    margin: 0 auto 0.5rem;
    color: var(--muted-text);
    opacity: 0.5;
  }

  .shortcut-hints {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.75rem;
    font-size: 0.6875rem;
    color: var(--muted-text);
    flex-wrap: wrap;
  }

  .shortcut-hints kbd {
    background: var(--elevated);
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    padding: 0.1rem 0.3rem;
    border-radius: 0.2rem;
    margin-right: 0.15rem;
  }
</style>

<script is:inline data-astro-rerun>
  (function() {
    var overlay = document.getElementById('search-palette');
    var input = document.getElementById('search-input');
    var resultsContainer = document.getElementById('search-results');
    var emptyState = document.getElementById('search-empty');
    var placeholder = document.getElementById('search-placeholder');
    var closeBtn = document.getElementById('close-search');

    if (!overlay || !input) return;

    var searchData = window.__searchDataCache || null;
    var activeIndex = -1;

    function fetchSearchData() {
      if (searchData) return Promise.resolve(searchData);
      return fetch('/api/search.json')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          searchData = data;
          window.__searchDataCache = data;
          return data;
        })
        .catch(function(e) {
          console.error("Failed to load search index", e);
          searchData = [];
          return [];
        });
    }

    function openSearch() {
      overlay.classList.remove('hidden');
      // Use setTimeout to ensure the overlay is rendered before focusing
      setTimeout(function() { input.focus(); }, 50);
      fetchSearchData();
    }

    function closeSearch() {
      overlay.classList.add('hidden');
      input.value = '';
      resultsContainer.innerHTML = '';
      if (emptyState) emptyState.classList.add('hidden');
      if (placeholder) placeholder.classList.remove('hidden');
      activeIndex = -1;
      input.blur();
    }

    function getResultItems() {
      return resultsContainer.querySelectorAll('.search-result-item');
    }

    function setActiveItem(index) {
      var items = getResultItems();
      for (var i = 0; i < items.length; i++) {
        items[i].classList.remove('is-active');
      }
      if (index < 0 || index >= items.length) {
        activeIndex = -1;
        return;
      }
      activeIndex = index;
      items[activeIndex].classList.add('is-active');
      items[activeIndex].scrollIntoView({ block: 'nearest' });
    }

    function performSearch(query) {
      activeIndex = -1;
      if (!query) {
        resultsContainer.innerHTML = '';
        if (emptyState) emptyState.classList.add('hidden');
        if (placeholder) placeholder.classList.remove('hidden');
        return;
      }
      if (placeholder) placeholder.classList.add('hidden');
      if (!searchData) return;

      var q = query.toLowerCase();
      var results = searchData.filter(function(item) {
        return item.title.toLowerCase().indexOf(q) !== -1 ||
               item.description.toLowerCase().indexOf(q) !== -1 ||
               item.tags.some(function(t) { return t.toLowerCase().indexOf(q) !== -1; }) ||
               item.content.toLowerCase().indexOf(q) !== -1;
      }).slice(0, 8);

      resultsContainer.innerHTML = '';

      if (results.length === 0) {
        if (emptyState) emptyState.classList.remove('hidden');
      } else {
        if (emptyState) emptyState.classList.add('hidden');
        results.forEach(function(result, i) {
          var li = document.createElement('li');
          var a = document.createElement('a');
          a.href = '/blog/' + result.slug;
          a.className = 'search-result-item';
          a.innerHTML =
            '<div class="search-result-title">' + result.title + '</div>' +
            '<div class="search-result-desc">' + result.description + '</div>';
          a.addEventListener('mouseenter', function() { setActiveItem(i); });
          li.appendChild(a);
          resultsContainer.appendChild(li);
        });
      }
    }

    // Remove any previous global handler to prevent duplicates
    if (window.__searchKeyHandler) {
      document.removeEventListener('keydown', window.__searchKeyHandler);
    }

    function handleKeydown(e) {
      var isOpen = !overlay.classList.contains('hidden');

      // Ctrl+K / Cmd+K — toggle search
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (isOpen) { closeSearch(); } else { openSearch(); }
        return;
      }

      // "/" — open & focus (only when not already in an input)
      if (e.key === '/' && !isOpen) {
        var tag = (document.activeElement && document.activeElement.tagName) ? document.activeElement.tagName.toLowerCase() : '';
        if (tag !== 'input' && tag !== 'textarea') {
          e.preventDefault();
          openSearch();
        }
        return;
      }

      if (!isOpen) return;

      // ESC
      if (e.key === 'Escape') {
        e.preventDefault();
        closeSearch();
        return;
      }

      // Arrow down
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        var items = getResultItems();
        if (items.length === 0) return;
        setActiveItem(activeIndex < items.length - 1 ? activeIndex + 1 : 0);
        return;
      }

      // Arrow up
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        var items2 = getResultItems();
        if (items2.length === 0) return;
        setActiveItem(activeIndex > 0 ? activeIndex - 1 : items2.length - 1);
        return;
      }

      // Enter — navigate
      if (e.key === 'Enter') {
        var allItems = getResultItems();
        if (activeIndex >= 0 && activeIndex < allItems.length) {
          e.preventDefault();
          var href = allItems[activeIndex].getAttribute('href');
          if (href) {
            closeSearch();
            window.location.href = href;
          }
        }
        return;
      }
    }

    window.__searchKeyHandler = handleKeydown;
    document.addEventListener('keydown', handleKeydown);

    closeBtn.addEventListener('click', closeSearch);
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) closeSearch();
    });

    input.addEventListener('input', function(e) {
      performSearch(e.target.value);
    });

    // Export for Navigation button
    window.openSearchPalette = openSearch;
  })();
</script>
